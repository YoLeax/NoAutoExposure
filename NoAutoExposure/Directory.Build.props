<Project>
  <PropertyGroup>
    <PluginId>NoAutoExposure</PluginId>
    <PluginName>No Auto-Exposure</PluginName>
    <Authors>Kaitlyn</Authors>
    <Copyright>Copyright © Kaitlyn 2022</Copyright>
    <Version>2.1.0</Version>
    <GameVersion>1.39.1</GameVersion>
    <Description>Disables Beat Saber's bloom-based auto-exposure while preserving tone mapping by default.</Description>
  </PropertyGroup>

  <ItemGroup>
    <DependsOn Include="BSIPA" Version="^4.3.0" />
    <DependsOn Include="BeatSaberMarkupLanguage" Version="^1.12.0" />
    <DependsOn Include="SiraUtil" Version="^3.1.0" />
    <DependsOn Include="SongCore" Version="^3.14.15" />
  </ItemGroup>

  <PropertyGroup>
    <BSMTProjectType>BSIPA</BSMTProjectType>
    <GenerateManifest>true</GenerateManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DisableZipRelease>true</DisableZipRelease>
  </PropertyGroup>
</Project>
